// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

// Deployment

DEPLOYMENT_LOCATION = YES
INSTALL_ROOT = $(HOME)
INSTALL_PATH = /Library/Graphics/FxCore
SKIP_INSTALL = NO

// Linking

FRAMEWORK_SEARCH_PATHS = /Library/Developer/SDKs/FxCore.sdk/Library/Frameworks
LD_RUNPATH_SEARCH_PATHS = @loader_path/../Frameworks

// Swift

SWIFT_OBJC_BRIDGING_HEADER = $(PROJECT_DIR)/Sources/SwiftBridging.h

// Localization

STRING_CATALOG_GENERATE_SYMBOLS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Packaging

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = $(PROJECT_DIR)/Configuration/Info.plist
PRODUCT_BUNDLE_IDENTIFIER = com.fxfactory.FxCore.Examples
WRAPPER_EXTENSION = plugin

// Versioning

MARKETING_VERSION = 1.0

// Allow overriding any setting through a local configuration file ignored by Source Control

#include? "ExamplesTarget.local.xcconfig"
