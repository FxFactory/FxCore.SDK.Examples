// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

PRODUCT_NAME = $(TARGET_NAME)

// Deployment

MACOSX_DEPLOYMENT_TARGET = 13.5
COPY_PHASE_STRIP_Debug = NO
COPY_PHASE_STRIP_Release = YES
COPY_PHASE_STRIP = $(COPY_PHASE_STRIP_$(CONFIGURATION))

// Localization

LOCALIZATION_PREFERS_STRING_CATALOGS = YES

// Info.plist

INFOPLIST_KEY_NSHumanReadableCopyright = © $(USER). All rights reserved.

// Search Paths

ALWAYS_SEARCH_USER_PATHS = NO

CODE_SIGN_INJECT_BASE_ENTITLEMENTS_Debug = YES
CODE_SIGN_INJECT_BASE_ENTITLEMENTS_Release = NO
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = $(CODE_SIGN_INJECT_BASE_ENTITLEMENTS_$(CONFIGURATION))

// Clang

GCC_DYNAMIC_NO_PIC = NO
GCC_NO_COMMON_BLOCKS = YES
GCC_OPTIMIZATION_LEVEL_Debug = 0
GCC_OPTIMIZATION_LEVEL_Release = 3
GCC_OPTIMIZATION_LEVEL = $(GCC_OPTIMIZATION_LEVEL_$(CONFIGURATION))
GCC_UNROLL_LOOPS_Debug = NO
GCC_UNROLL_LOOPS_Release = YES
GCC_UNROLL_LOOPS = $(GCC_UNROLL_LOOPS_$(CONFIGURATION))

// Clang - Code Generation

LLVM_LTO_Debug = NO
LLVM_LTO_Release = YES
LLVM_LTO = $(LLVM_LTO_$(CONFIGURATION))
GCC_INLINES_ARE_PRIVATE_EXTERN = YES
GCC_SYMBOLS_PRIVATE_EXTERN = YES

// Clang - Language - Models

CLANG_ENABLE_MODULES = YES
CLANG_MODULES_AUTOLINK = YES

// Clang - Language - Objective-C

CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_OBJC_WEAK = YES
ENABLE_NS_ASSERTIONS = NO
ENABLE_STRICT_OBJC_MSGSEND = YES

// Clang - Preprocessing

GCC_PREPROCESSOR_DEFINITIONS_Debug = $(inherited) DEBUG
GCC_PREPROCESSOR_DEFINITIONS_Release = $(inherited) NDEBUG NS_BLOCK_ASSERTIONS
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) $(GCC_PREPROCESSOR_DEFINITIONS_$(CONFIGURATION)) CI_SILENCE_GL_DEPRECATION GL_SILENCE_DEPRECATION QC_SILENCE_GL_DEPRECATION QC_SILENCE_DEPRECATION

// Clang - Warnings

GCC_WARN_UNUSED_VARIABLE_Debug = YES
GCC_WARN_UNUSED_VARIABLE_Release = NO
GCC_WARN_UNUSED_VARIABLE = $(GCC_WARN_UNUSED_VARIABLE_$(CONFIGURATION))
GCC_WARN_ABOUT_RETURN_TYPE = YES_ERROR
GCC_WARN_64_TO_32_BIT_CONVERSION = YES
GCC_WARN_NON_VIRTUAL_DESTRUCTOR = YES
GCC_WARN_HIDDEN_VIRTUAL_FUNCTIONS = YES
GCC_WARN_TYPECHECK_CALLS_TO_PRINTF = YES
GCC_WARN_INITIALIZER_NOT_FULLY_BRACKETED = YES
GCC_WARN_MISSING_PARENTHESES = YES
GCC_WARN_CHECK_SWITCH_STATEMENTS = YES
GCC_WARN_UNUSED_FUNCTION = YES
GCC_WARN_UNUSED_VALUE = YES
GCC_WARN_UNINITIALIZED_AUTOS = YES
GCC_WARN_SHADOW = YES
GCC_WARN_UNUSED_LABEL = YES
GCC_WARN_ABOUT_MISSING_FIELD_INITIALIZERS = YES
GCC_WARN_FOUR_CHARACTER_CONSTANTS = NO
GCC_WARN_ABOUT_MISSING_NEWLINE = YES
GCC_WARN_STRICT_SELECTOR_MATCH = NO
GCC_WARN_UNDECLARED_SELECTOR = YES
GCC_WARN_SIGN_COMPARE = YES
GCC_WARN_UNKNOWN_PRAGMAS = YES
GCC_WARN_ABOUT_MISSING_PROTOTYPES = NO

GCC_TREAT_INCOMPATIBLE_POINTER_TYPE_WARNINGS_AS_ERRORS = YES
GCC_TREAT_IMPLICIT_FUNCTION_DECLARATIONS_AS_ERRORS = YES

CLANG_WARN_IMPLICIT_SIGN_CONVERSION = YES
CLANG_WARN_UNREACHABLE_CODE = YES
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES
CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS = YES
CLANG_WARN_EMPTY_BODY = YES
CLANG_WARN_SUSPICIOUS_IMPLICIT_CONVERSION = YES
CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF = YES
CLANG_WARN_OBJC_REPEATED_USE_OF_WEAK = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_DIRECT_OBJC_ISA_USAGE = YES_ERROR
CLANG_WARN_OBJC_ROOT_CLASS = YES_ERROR
CLANG_WARN_OBJC_EXPLICIT_OWNERSHIP_TYPE = YES
CLANG_WARN_ASSIGN_ENUM = YES
CLANG_WARN_SUSPICIOUS_MOVE = YES
CLANG_WARN_INFINITE_RECURSION = YES
CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING = YES
CLANG_WARN_STRICT_PROTOTYPES = YES
CLANG_WARN_COMMA = YES
CLANG_WARN_RANGE_LOOP_ANALYSIS = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
CLANG_WARN_SEMICOLON_BEFORE_METHOD_BODY = YES
CLANG_WARN__EXIT_TIME_DESTRUCTORS = YES
CLANG_WARN_CXX0X_EXTENSIONS = YES
CLANG_WARN_OBJC_INTERFACE_IVARS = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = YES
CLANG_WARN_FRAMEWORK_INCLUDE_PRIVATE_FROM_PUBLIC = YES
CLANG_WARN_IMPLICIT_FALLTHROUGH = YES
CLANG_WARN_COMPLETION_HANDLER_MISUSE = YES
CLANG_ANALYZER_NONNULL = YES_AGGRESSIVE
CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION = YES_AGGRESSIVE
CLANG_ANALYZER_USE_AFTER_MOVE = YES_AGGRESSIVE

// Swift

SWIFT_VERSION = 6

// Asset Catalog

ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// Metal

MTL_LANGUAGE_REVISION = UseDeploymentTarget
MTL_ENABLE_DEBUG_INFO_Debug = INCLUDE_SOURCE
MTL_ENABLE_DEBUG_INFO_Release = NO
MTL_ENABLE_DEBUG_INFO = $(MTL_ENABLE_DEBUG_INFO_$(CONFIGURATION))
MTL_ENABLE_MODULES = YES
MTL_OPTIMIZATION_LEVEL_Debug = 0
MTL_OPTIMIZATION_LEVEL_Release = 3
MTL_OPTIMIZATION_LEVEL = $(MTL_OPTIMIZATION_LEVEL_$(CONFIGURATION))
MTL_MATH_MODE = SAFE
MTL_MATH_FP32_FUNCTIONS = PRECISE

// Code Signing

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
CODE_SIGNING_ALLOWED = YES
OTHER_CODE_SIGN_FLAGS_Debug =
OTHER_CODE_SIGN_FLAGS_Release = --timestamp
OTHER_CODE_SIGN_FLAGS = $(OTHER_CODE_SIGN_FLAGS_$(CONFIGURATION))

// App Sandbox & Hardened Runtime

ENABLE_HARDENED_RUNTIME = YES

// Versioning

CURRENT_PROJECT_VERSION = 1

// Allow overriding any setting through a local configuration file ignored by Source Control

#include? "ExamplesProject.local.xcconfig"
